# Nastavení připojení k jazykovému modelu.
# Zkopírujte tento soubor jako .env a nechte odkomentovanou jen jednu variantu.

# --- Varianta A: Ollama na vlastním počítači ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:4b
EMBED_MODEL=embeddinggemma

# --- Varianta B: Ollama na školním serveru (adresu dostanete od vyučujícího) ---
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gemma4:12b
# EMBED_MODEL=embeddinggemma

# --- Varianta C: cloudové API, např. Google Gemini ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=sem-vlozte-svuj-klic
# LLM_MODEL=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-001
